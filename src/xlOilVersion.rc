// Windows version information (file Properties > Details) for every xlOil binary.
//
// Added to each DLL / XLL / PYD project by src/BuildPaths.props, which passes the binary's
// file name (XLO_FILENAME) and project name (XLO_PROJECT). Binaries without version
// information look more suspicious to anti-virus heuristics such as Windows Defender's
// machine-learning check.
//
// Keep the numbers in step with include/xloil/Version.h (a Python test checks this).
// The fork's post-release number is deliberately not included: CI reuses unchanged
// binaries across fork releases, so it would go stale.

#include <winver.h>

#define XLO_VERSION_NUM 0,22,1,0
#define XLO_VERSION_STR "0.22.1"

#ifndef XLO_FILENAME
#define XLO_FILENAME "xlOil"
#endif
#ifndef XLO_PROJECT
#define XLO_PROJECT "xlOil"
#endif

LANGUAGE 0x09, 0x01   // English (United States)

1 VERSIONINFO
 FILEVERSION     XLO_VERSION_NUM
 PRODUCTVERSION  XLO_VERSION_NUM
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_DLL
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "xlOil (Esmaeelpour fork)"
            VALUE "FileDescription",  "xlOil Excel add-in framework"
            VALUE "FileVersion",      XLO_VERSION_STR
            VALUE "InternalName",     XLO_PROJECT
            VALUE "LegalCopyright",   "Copyright 2020 Steven Cunnane. Apache License 2.0"
            VALUE "OriginalFilename", XLO_FILENAME
            VALUE "ProductName",      "xlOil"
            VALUE "ProductVersion",   XLO_VERSION_STR
            VALUE "Comments",         "https://github.com/Esmaeelpour/xloil"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
